# ====== Claude AI Configuration ======
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096

# ====== Omniroute Configuration ======
OMNIROUTE_HOST=localhost
OMNIROUTE_PORT=20128
OMNIROUTE_DEBUG=False

# ====== Database Configuration ======
DATABASE_TYPE=mongodb
DATABASE_URL=mongodb://localhost:27017/omniroute
DATABASE_NAME=omniroute_db
DATABASE_USER=admin
DATABASE_PASSWORD=your_password

# ====== PostgreSQL Configuration (Alternative) ======
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/omniroute_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_password

# ====== SQLite Configuration (Alternative) ======
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite:///./omniroute.db

# ====== Third Party API Keys ======
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-google-cse-id
SERPAPI_API_KEY=your-serpapi-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=omniroute-index

# ====== Redis Cache Configuration ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# ====== Authentication & Security ======
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====== CORS Configuration ======
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ====== Logging Configuration ======
LOG_LEVEL=INFO
LOG_FILE=logs/omniroute.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ====== Server Configuration ======
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=20128
WORKERS=4
TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1

# ====== API Rate Limiting ======
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ====== File Upload Configuration ======
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,txt,doc,docx,json,csv

# ====== Email Configuration ======
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@omniroute.com
SMTP_FROM_NAME=Omniroute

# ====== Webhook Configuration ======
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3

# ====== S3/Cloud Storage Configuration ======
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=omniroute-bucket
AWS_S3_PREFIX=uploads/

# ====== Monitoring & Analytics ======
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key
ENABLE_METRICS=True
METRICS_PORT=9090

# ====== Feature Flags ======
ENABLE_CLAUDE_AI=True
ENABLE_SEARCH_TOOL=True
ENABLE_DATABASE_TOOL=True
ENABLE_RETRIEVAL_TOOL=True
ENABLE_CACHE=True
ENABLE_WEBHOOKS=True

# ====== Version & Build Info ======
APP_VERSION=1.0.0
APP_NAME=Omniroute
BUILD_DATE=2026-09-13
GIT_COMMIT=main
